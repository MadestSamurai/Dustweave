<Window x:Class="BD2FiendHunter.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="{DynamicResource title}" Width="540" Height="550" MinWidth="490" MinHeight="520" WindowStartupLocation="CenterScreen">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource title}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource subtitle}" Foreground="#5B6670" Margin="0,5,0,0"/></StackPanel><ComboBox Grid.Column="1" x:Name="LanguageBox" Height="30" VerticalAlignment="Top" SelectionChanged="LanguageChanged" AutomationProperties.Name="Language"><ComboBoxItem Content="简体中文" Tag="zh-CN"/><ComboBoxItem Content="English" Tag="en-US"/></ComboBox></Grid>
 <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="18" Margin="0,20,0,16"><StackPanel>
  <TextBlock Text="{DynamicResource config}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{DynamicResource hint}" Foreground="#5B6670" Margin="0,8,0,0" TextWrapping="Wrap"/>
  <TextBlock x:Name="PlayerText" Margin="0,18,0,7"/><ProgressBar x:Name="PlayerBar" Height="7" Maximum="1" Foreground="#176B57" AutomationProperties.Name="Player HP"/>
  <TextBlock x:Name="BossText" Margin="0,14,0,7"/><ProgressBar x:Name="BossBar" Height="7" Maximum="1" Foreground="#A65B45" AutomationProperties.Name="Boss HP"/>
 </StackPanel></Border>
 <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="#5B6670" TextWrapping="Wrap" LineHeight="21"/>
 <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,16"><Button x:Name="StartButton" Content="{DynamicResource start}" Click="Start" Height="38" Padding="18,0" Background="#176B57" Foreground="White" BorderThickness="0"/><Button Content="{DynamicResource pause}" Click="Pause" Height="38" Padding="16,0" Margin="8,0,0,0"/><Button Content="{DynamicResource diagnostics}" Click="Diagnostics" Height="38" Padding="12,0" Margin="8,0,0,0"/></StackPanel>
 <StackPanel Grid.Row="4"><TextBlock Text="{DynamicResource free}" FontSize="11" Foreground="#5B6670" TextWrapping="Wrap"/><TextBlock FontSize="11" Margin="0,5,0,0"><Hyperlink NavigateUri="https://github.com/MadestSamurai/bd2-fiend-hunter" RequestNavigate="OpenSource"><Run Text="{DynamicResource source}"/></Hyperlink><Run Text="  ·  0.1.2"/></TextBlock><TextBlock Text="{DynamicResource risk}" FontSize="11" Foreground="#5B6670" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
 </Grid>
</Window>