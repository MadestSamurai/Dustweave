<Window x:Class="BD2InfiniteGacha.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="BD2 无限抽抽乐助手" Width="1260" Height="900" MinWidth="1060" MinHeight="760" WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackground}">
 <Window.Resources>
  <DataTemplate x:Key="CostumeItem"><Grid MinHeight="44"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" MinWidth="46"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,6,0"><TextBlock Text="{Binding Character}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedInk}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding LevelLabel}" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></DataTemplate>
  <Style x:Key="TargetList" TargetType="ListBox"><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="4"/><Setter Property="SelectionMode" Value="Extended"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/><Setter Property="ItemTemplate" Value="{StaticResource CostumeItem}"/><Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="7,3"/><Setter Property="Margin" Value="0,1"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Frame" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent" CornerRadius="3"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource SurfaceMuted}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource PrimarySoft}"/><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Primary}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Focus}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16"><ComboBox x:Name="LanguageChoice" DockPanel.Dock="Right" Width="116" Margin="12,0,0,0" MinHeight="34" VerticalAlignment="Center" VerticalContentAlignment="Center" SelectionChanged="Language_Changed" AutomationProperties.Name="Language / 语言"><ComboBoxItem Content="简体中文"/><ComboBoxItem Content="English"/></ComboBox><Button x:Name="ConnectButton" DockPanel.Dock="Right" Content="连接游戏" Click="Connect_Click" VerticalAlignment="Center" Margin="14,0,0,0"/><StackPanel><TextBlock Text="无限抽抽乐助手" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="ConnectionText" Text="连接后自动读取可抽服装与当前账号的强化等级" Foreground="{StaticResource MutedInk}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Panel}" Padding="16"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="目标服装" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/><ComboBox Grid.Column="1" x:Name="Pools" TextSearch.TextPath="Title" SelectionChanged="Pool_Changed" MinHeight="48" MaxDropDownHeight="360" VerticalContentAlignment="Center" AutomationProperties.Name="选择无限抽抽乐卡池" ToolTip="截止时间按本机时区显示，由新到旧排列"><ComboBox.ItemTemplate><DataTemplate><StackPanel Margin="0,2" ToolTip="{Binding Detail}"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource MutedInk}" Margin="0,2,0,0"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
    <WrapPanel Grid.Row="1" x:Name="GroupActions" Margin="0,0,0,10"><Button x:Name="AddUnfilled" Content="未满服装 → B" Click="Unfilled_Click" Margin="0,0,8,6" Style="{StaticResource PrimaryButton}"/><Button x:Name="AddCostumesButton" Content="添加服装…" Click="AddCostumes_Click" Margin="0,0,8,6"/><Button Content="移除已 +5" Click="RemoveFull_Click" Margin="0,0,0,6"/></WrapPanel>
    <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="Search" TextChanged="Filter_Changed" AutomationProperties.Name="搜索 A B 列表"/><TextBlock Text="搜索 A／B 中的角色、服装…" IsHitTestVisible="False" Foreground="{StaticResource MutedInk}" VerticalAlignment="Center" Margin="12,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><ComboBox Grid.Column="1" x:Name="Filter" SelectedIndex="0" SelectionChanged="Filter_Selection" Margin="8,0,0,0" VerticalContentAlignment="Center" AutomationProperties.Name="筛选两组服装"><ComboBoxItem Content="全部破度"/><ComboBoxItem Content="未满 +5"/><ComboBoxItem Content="已经 +5"/></ComboBox></Grid>
    <Grid Grid.Row="3" x:Name="GroupsPanel"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,10"><TextBlock x:Name="BHeading" Text="B 组 · 补充目标" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="BCount" Text="0 件" FontSize="12" Foreground="{StaticResource MutedInk}" Margin="0,4,0,0"/></StackPanel><Grid Grid.Row="1"><ListBox x:Name="BList" Style="{StaticResource TargetList}" SelectionChanged="TargetSelection_Changed" MouseDoubleClick="B_DoubleClick" PreviewKeyDown="Target_KeyDown" AutomationProperties.Name="B 组服装列表"/><TextBlock x:Name="BEmpty" Text="点击上方「未满服装 → B」，或添加服装。" Margin="14" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedInk}" IsHitTestVisible="False"/></Grid><DockPanel Grid.Row="2" Margin="0,9,0,0"><Button x:Name="RemoveBButton" Content="移出 B" Click="RemoveB_Click" DockPanel.Dock="Right"/><Button Content="全选" Click="SelectB_Click" HorizontalAlignment="Left"/></DockPanel></Grid>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0"><Button x:Name="PromoteButton" Content="移入 A →" Padding="4,7" Click="ToA_Click"/><Button x:Name="DemoteButton" Content="← 移回 B" Padding="4,7" Click="ToB_Click" Margin="0,10,0,0"/></StackPanel>
     <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,10"><TextBlock Text="A 组 · 优先目标" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="ACount" Text="0 件" FontSize="12" Foreground="{StaticResource MutedInk}" Margin="0,4,0,0"/></StackPanel><Grid Grid.Row="1"><ListBox x:Name="AList" Style="{StaticResource TargetList}" SelectionChanged="TargetSelection_Changed" MouseDoubleClick="A_DoubleClick" PreviewKeyDown="Target_KeyDown" AutomationProperties.Name="A 组服装列表"/><TextBlock x:Name="AEmpty" Text="从 B 组选择服装，再点击「移入 A」。" Margin="14" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedInk}" IsHitTestVisible="False"/></Grid><DockPanel Grid.Row="2" Margin="0,9,0,0"><Button x:Name="RemoveAButton" Content="移出 A" Click="RemoveA_Click" DockPanel.Dock="Right"/><Button Content="全选" Click="SelectA_Click" HorizontalAlignment="Left"/></DockPanel></Grid>
    </Grid>
    <TextBlock Grid.Row="4" x:Name="GroupSummary" Text="双击可互移；Ctrl／Shift 多选，Delete 移出分组。" Foreground="{StaticResource MutedInk}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
   </Grid></Border>
   <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <StackPanel><TextBlock Text="停止条件" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="优先判断 A；满足任一启用条件即停止。" TextWrapping="Wrap" Foreground="{StaticResource MutedInk}" FontSize="12" Margin="0,6,0,14"/>
     <StackPanel x:Name="TopSettings"><WrapPanel VerticalAlignment="Center"><TextBlock Text="A 至少" VerticalAlignment="Center"/><TextBox x:Name="Threshold" Width="54" Margin="8,0" TextChanged="Threshold_Changed" AutomationProperties.Name="A 组无条件停止阈值"/><TextBlock Text="个，无条件停止" VerticalAlignment="Center"/></WrapPanel><TextBlock x:Name="TopError" Foreground="{StaticResource Error}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="填写 1–10，下方自动生成更低的 A 档位。" TextWrapping="Wrap" Foreground="{StaticResource MutedInk}" FontSize="12" Margin="0,5,0,12"/></StackPanel>
    </StackPanel>
    <StackPanel><ItemsControl x:Name="Conditions"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,10" Margin="0,0,5,0"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Enabled,Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="启用此停止条件"/><TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"/><TextBox Grid.Column="2" Text="{Binding B,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Enabled}" AutomationProperties.Name="B 组至少命中数量"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Error}"/><Setter Property="Background" Value="{StaticResource ErrorSoft}"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox></Grid><TextBlock Text="{Binding Error}" Foreground="{StaticResource Error}" TextWrapping="Wrap" FontSize="12" Margin="24,4,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="ConditionsHint" Text="低档位可以单独启用；例如 A = 2 时，需要 B ≥ 3。禁用 A = 0，即要求至少抽到一个 A。" Foreground="{StaticResource MutedInk}" FontSize="12" TextWrapping="Wrap" Margin="0,12,8,12"/></StackPanel>
    <StackPanel Grid.Row="2" x:Name="OtherSettings" Margin="0,12,0,0"><CheckBox x:Name="CountCopies" Content="重复服装按张数累计" IsChecked="True" Click="Counting_Changed"/><CheckBox x:Name="ExcludeOverflow" Content="溢出服装不计" IsChecked="True" Click="Overflow_Changed" Margin="22,8,0,0"/><TextBlock x:Name="OverflowHelp" Text="只计补到 +5 所需张数；+4 最多计 1 张，未拥有最多计 6 张。" Foreground="{StaticResource MutedInk}" FontSize="12" TextWrapping="Wrap" Margin="22,4,0,6"/><TextBlock x:Name="CountingHelp" Text="取消「按张数累计」后，同款只计一次。" TextWrapping="Wrap" Foreground="{StaticResource MutedInk}" FontSize="12" Margin="22,4,0,12"/><WrapPanel><TextBlock Text="刷新间隔" VerticalAlignment="Center"/><TextBox x:Name="Interval" Text="1000" Width="76" Margin="10,0,8,0" TextChanged="Interval_Changed" AutomationProperties.Name="刷新间隔毫秒"/><TextBlock Text="ms" VerticalAlignment="Center"/></WrapPanel><TextBlock Text="自动跳过抽取动画，完整结果判定后再刷新。" Foreground="{StaticResource MutedInk}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="12" Margin="0,14,0,0"><Expander x:Name="ResultExpander" Header="当前十连结果（可展开）" IsExpanded="False"><ItemsControl x:Name="ResultCards" Margin="0,10,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{Binding Background}" CornerRadius="4" Padding="8" Margin="3" MinHeight="50"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedInk}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander></Border>
  <WrapPanel Grid.Row="3" Margin="0,12,0,0" VerticalAlignment="Center">
   <TextBlock Text="目标达成提醒" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,6"/>
   <CheckBox x:Name="NotifyWindows" Content="Windows 通知" Click="Notification_Changed" VerticalAlignment="Center" Margin="0,0,18,6" ToolTip="系统通知可能受 Windows 免打扰设置影响。"/>
   <CheckBox x:Name="NotifyPopup" Content="弹窗" Click="Notification_Changed" VerticalAlignment="Center" Margin="0,0,18,6"/>
   <CheckBox x:Name="NotifySound" Content="声音" Click="Notification_Changed" VerticalAlignment="Center" Margin="0,0,18,6"/>
   <Button x:Name="TestNotification" Content="测试提醒" Click="TestNotification_Click" Padding="10,4" MinHeight="28" Margin="0,0,0,6"/>
  </WrapPanel>
  <Grid Grid.Row="4" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock x:Name="StatusText" Text="先连接游戏，再选择 A／B 组与停止条件。" TextWrapping="Wrap"/><TextBlock x:Name="ValidationText" Foreground="{StaticResource Error}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="StartButton" Content="开始刷新" Click="Start_Click" Style="{StaticResource PrimaryButton}"/><Button x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False" Margin="8,0,0,0"/></StackPanel></Grid>
 </Grid>
</Window>
