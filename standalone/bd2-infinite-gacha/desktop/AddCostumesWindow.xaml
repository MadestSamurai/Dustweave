<Window x:Class="BD2InfiniteGacha.Desktop.AddCostumesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="添加服装" Width="640" Height="610" MinWidth="540" MinHeight="420" WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackground}">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock Text="添加服装" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="这里只显示未分组的可抽服装。Ctrl／Shift 可多选。" Foreground="{StaticResource MutedInk}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="Query" TextChanged="Query_Changed" AutomationProperties.Name="搜索未分组服装"/><TextBlock Text="搜索角色、服装或 ID…" IsHitTestVisible="False" Foreground="{StaticResource MutedInk}" VerticalAlignment="Center" Margin="12,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=Query}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><ComboBox x:Name="Enhancement" Grid.Column="1" SelectedIndex="0" Margin="8,0,0,0" SelectionChanged="Enhancement_Changed" VerticalContentAlignment="Center"><ComboBoxItem Content="全部破度"/><ComboBoxItem Content="未满 +5"/><ComboBoxItem Content="已经 +5"/></ComboBox></Grid>
  <Grid Grid.Row="2"><ListBox x:Name="Choices" SelectionChanged="Choices_Changed" AutomationProperties.Name="可添加服装"/><TextBlock x:Name="Empty" Text="没有符合条件的未分组服装" Foreground="{StaticResource MutedInk}" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/></Grid>
  <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Count" VerticalAlignment="Center" Foreground="{StaticResource MutedInk}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="AddB" Content="加入 B" Click="AddB_Click" Style="{StaticResource PrimaryButton}"/><Button x:Name="AddA" Content="加入 A" Click="AddA_Click" Margin="8,0,0,0"/><Button Content="取消" IsCancel="True" Margin="8,0,0,0"/></StackPanel></Grid>
 </Grid>
</Window>
