<Project Sdk="Microsoft.NET.Sdk">
<!-- Component identity includes embedded sources and build metadata; current components use same-process handoff. -->
<PropertyGroup><Version>0.3.6</Version><TargetFramework>net8.0-windows</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
<ItemGroup>
<PackageReference Include="Mono.Cecil" Version="0.11.6" />
<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
<PackageReference Include="Lib.Harmony" Version="2.4.2" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="compile;runtime" />
<EmbeddedResource Include="$(PkgLib_Harmony)/lib/net472/0Harmony.dll" LogicalName="BD2ApostleDefense.Harmony.dll" />
<EmbeddedResource Include="../hook/*.cs" LogicalName="Hook.%(Filename)%(Extension)" />
<EmbeddedResource Include="../shared/*.cs" LogicalName="Hook.%(Filename)%(Extension)" />
<EmbeddedResource Include="contract.json" Condition="Exists('contract.json')" LogicalName="BD2ApostleDefense.Contract.json" />
</ItemGroup>
<ItemGroup><EmbeddedResource Include="../ipc/common/*.cs" LogicalName="Hook.%(Filename)%(Extension)"/><EmbeddedResource Include="../ipc/runtime/*.cs" LogicalName="Hook.%(Filename)%(Extension)"/></ItemGroup></Project>
