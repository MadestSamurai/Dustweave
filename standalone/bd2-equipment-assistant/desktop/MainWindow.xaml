<Window x:Class="BD2Equipment.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource Label1}" Width="1240" Height="960" MinWidth="900" MinHeight="720" Background="{StaticResource AppBackground}" WindowStartupLocation="CenterScreen" Closing="WindowClosing">
 <Window.Resources>
  <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="Margin" Value="8,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserReorderColumns" Value="False"/><Setter Property="CanUserSortColumns" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="RowHeight" Value="36"/><Setter Property="EnableRowVirtualization" Value="True"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="10,9"/><Setter Property="Background" Value="{StaticResource SurfaceMuted}"/><Setter Property="Foreground" Value="{StaticResource MutedInk}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,5"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="9,6"/></Style>
 </Window.Resources>
 <Grid Margin="24,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16"><ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="140" Margin="16,0,0,0" VerticalAlignment="Center" SelectionChanged="LanguageChanged"><ComboBoxItem Content="简体中文" Tag="zh-CN"/><ComboBoxItem Content="English" Tag="en-US"/></ComboBox><TextBlock DockPanel.Dock="Right" x:Name="VersionText" Text="0.3.3" VerticalAlignment="Center" Foreground="{StaticResource MutedInk}"/><StackPanel><TextBlock Text="{DynamicResource Label2}" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Label3}" Margin="0,5,0,0" Foreground="{StaticResource MutedInk}"/></StackPanel></DockPanel>
  <Border Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="8" Padding="18" Margin="0,0,0,14">
   <DockPanel><Button x:Name="ConnectButton" DockPanel.Dock="Right" Content="{DynamicResource Label4}" Click="ReadClick" Margin="16,0,0,0" VerticalAlignment="Center"/>
    <StackPanel><TextBlock x:Name="AccountText" Text="{DynamicResource Label5}" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="InventoryText" Text="{DynamicResource Label6}" Margin="0,5,0,0" Foreground="{StaticResource MutedInk}" TextWrapping="Wrap"/></StackPanel>
   </DockPanel>
  </Border>
  <TabControl x:Name="ModeTabs" Grid.Row="2" BorderThickness="0" Background="Transparent" SelectionChanged="ModeChanged">
   <TabItem Header="{DynamicResource Label7}">
    <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="18" Margin="0,10,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <WrapPanel Margin="0,0,0,8">
      <StackPanel Width="130" Margin="0,0,16,8"><TextBlock Text="{DynamicResource Label8}" Margin="0,0,0,6"/><ComboBox x:Name="LevelInput" SelectionChanged="SettingsChanged" AutomationProperties.Name="{DynamicResource Label9}"/></StackPanel>
      <StackPanel Width="160" Margin="0,0,16,8"><TextBlock Text="{DynamicResource Label10}" Margin="0,0,0,6"/><TextBox x:Name="CountInput" TextChanged="SettingsChanged" ToolTip="{DynamicResource Label11}" AutomationProperties.Name="{DynamicResource Label12}"/></StackPanel>
      <StackPanel Width="175" Margin="0,0,16,8"><TextBlock Text="{DynamicResource Label13}" Margin="0,0,0,6"/><TextBox x:Name="GoldInput" TextChanged="SettingsChanged" ToolTip="{DynamicResource Label14}" AutomationProperties.Name="{DynamicResource Label15}"/></StackPanel>
      <StackPanel Width="160" Margin="0,0,0,8"><TextBlock Text="{DynamicResource Label16}" Margin="0,0,0,6"/><TextBox x:Name="PotionInput" TextChanged="SettingsChanged" ToolTip="{DynamicResource Label17}" AutomationProperties.Name="{DynamicResource Label18}"/></StackPanel>
     </WrapPanel>
     <CheckBox x:Name="FiveInput" Grid.Row="1" Content="{DynamicResource Label19}" Checked="SettingsChanged" Unchecked="SettingsChanged" Margin="0,0,0,8"/>
     <TextBlock Grid.Row="2" Text="{DynamicResource Label20}" Foreground="{StaticResource MutedInk}" TextWrapping="Wrap" Margin="0,0,0,14"/>
     <Grid Grid.Row="3" MinHeight="100" MaxHeight="240"><DataGrid x:Name="RecipeGrid" IsReadOnly="True" AutomationProperties.Name="{DynamicResource Label21}">
      <DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{DynamicResource Label22}" Binding="{Binding Name}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{DynamicResource Label23}" Binding="{Binding Count}" Width="95"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{DynamicResource Label24}" Binding="{Binding Gold}" Width="125"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{DynamicResource Label25}" Binding="{Binding Potions}" Width="105"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{DynamicResource Label26}" Binding="{Binding Powder}" Width="105"/></DataGrid.Columns>
     </DataGrid><TextBlock x:Name="PlanEmpty" Text="{DynamicResource Label27}" Foreground="{StaticResource MutedInk}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
     <ScrollViewer Grid.Row="4" MaxHeight="130" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"><TextBlock x:Name="MaterialText" Text="{DynamicResource Label28}" TextWrapping="Wrap" Foreground="{StaticResource MutedInk}" LineHeight="23"/></ScrollViewer>
    </Grid></ScrollViewer></Border>
   </TabItem>
   <TabItem Header="{DynamicResource Label29}">
    <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="16" Margin="0,10,0,0">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid MinHeight="650" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="140"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,12"><WrapPanel>
       <StackPanel Width="150" Margin="0,0,16,8"><TextBlock Text="{DynamicResource Label30}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,5"/><ComboBox x:Name="TargetInput" SelectionChanged="SettingsChanged" AutomationProperties.Name="{DynamicResource Label31}"/></StackPanel>
       <StackPanel Width="155" Margin="0,0,16,8"><TextBlock Text="{DynamicResource Label32}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,5"/><TextBox x:Name="RefineGoldInput" Text="100000" TextChanged="SettingsChanged"/></StackPanel>
       <StackPanel Width="155" Margin="0,0,16,8"><TextBlock Text="{DynamicResource Label33}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,5"/><TextBox x:Name="RefinePowderInput" Text="10000" TextChanged="SettingsChanged"/></StackPanel>
       <StackPanel Width="180" Margin="0,0,16,8"><TextBlock Text="{DynamicResource Label34}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,5"/><TextBox x:Name="BatchInput" Text="5000" TextChanged="SettingsChanged" AutomationProperties.Name="{DynamicResource Label35}"/></StackPanel>
      </WrapPanel>
      <CheckBox x:Name="HigherInput" Content="{DynamicResource Label36}" Checked="SettingsChanged" Unchecked="SettingsChanged" Margin="0,2,0,6"/>
      <TextBlock x:Name="RefineHint" Foreground="{StaticResource MutedInk}" TextWrapping="Wrap"/>
      </StackPanel>
      <WrapPanel Grid.Row="1">
       <StackPanel Width="290" Margin="0,0,12,10"><TextBlock Text="{DynamicResource Label37}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,5"/><TextBox x:Name="SearchInput" TextChanged="SearchChanged" ToolTip="{DynamicResource Label38}"/></StackPanel>
       <StackPanel Width="105" Margin="0,0,12,10"><TextBlock Text="{DynamicResource Label39}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,5"/><ComboBox x:Name="SlotFilter" SelectionChanged="FilterChanged"/></StackPanel>
       <StackPanel Width="115" Margin="0,0,12,10"><TextBlock Text="{DynamicResource Label40}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,5"/><ComboBox x:Name="KindFilter" SelectionChanged="FilterChanged"/></StackPanel>
       <StackPanel Width="130" Margin="0,0,12,10"><TextBlock Text="{DynamicResource Label41}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,5"/><ComboBox x:Name="RarityFilter" SelectionChanged="FilterChanged"/></StackPanel>
       <StackPanel Width="100" Margin="0,0,12,10"><TextBlock Text="{DynamicResource Label42}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,5"/><ComboBox x:Name="QualityFilter" SelectionChanged="FilterChanged"/></StackPanel>
       <StackPanel Width="150" Margin="0,0,12,10"><TextBlock Text="{DynamicResource Label43}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,5"/><ComboBox x:Name="OwnerFilter" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" SelectionChanged="FilterChanged" TextBoxBase.TextChanged="FilterTextChanged"/></StackPanel>
       <StackPanel Width="150" Margin="0,0,12,10"><TextBlock Text="{DynamicResource Label44}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,5"/><ComboBox x:Name="ExclusiveFilter" IsEditable="True" IsTextSearchEnabled="True" SelectionChanged="FilterChanged" TextBoxBase.TextChanged="FilterTextChanged"/></StackPanel>
       <StackPanel Width="115" Margin="0,0,12,10"><TextBlock Text="{DynamicResource Label45}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,5"/><ComboBox x:Name="WornFilter" SelectionChanged="FilterChanged"/></StackPanel>
       <StackPanel Width="115" Margin="0,0,12,10"><TextBlock Text="{DynamicResource Label46}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,5"/><ComboBox x:Name="LockFilter" SelectionChanged="FilterChanged"/></StackPanel>
       <StackPanel Width="115" Margin="0,0,12,10"><TextBlock Text="{DynamicResource Label47}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,5"/><ComboBox x:Name="KeepFilter" SelectionChanged="FilterChanged"/></StackPanel>
       <StackPanel Width="115" Margin="0,0,12,10"><TextBlock Text="{DynamicResource Label48}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,5"/><ComboBox x:Name="LevelFilter" SelectionChanged="FilterChanged"/></StackPanel>
       <StackPanel Width="125" Margin="0,0,12,10"><TextBlock Text="{DynamicResource Label49}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,5"/><ComboBox x:Name="MainStatFilter" SelectionChanged="FilterChanged"/></StackPanel>
       <StackPanel Width="125" Margin="0,0,12,10"><TextBlock Text="{DynamicResource Label50}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,5"/><ComboBox x:Name="SubStatFilter" SelectionChanged="FilterChanged"/></StackPanel>
       <StackPanel Width="105" Margin="0,0,12,10"><TextBlock Text="{DynamicResource Label51}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,5"/><ComboBox x:Name="SubCountFilter" SelectionChanged="FilterChanged"/></StackPanel>
       <StackPanel Width="90" Margin="0,0,12,10"><TextBlock Text="{DynamicResource Label52}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,5"/><ComboBox x:Name="ScoreMinFilter" SelectionChanged="FilterChanged"/></StackPanel>
       <StackPanel Width="90" Margin="0,0,12,10"><TextBlock Text="{DynamicResource Label53}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,5"/><ComboBox x:Name="ScoreMaxFilter" SelectionChanged="FilterChanged"/></StackPanel>
       <StackPanel Width="165" Margin="0,0,12,10"><TextBlock Text="{DynamicResource Label54}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,5"/><ComboBox x:Name="SortFilter" SelectionChanged="FilterChanged"/></StackPanel>
      </WrapPanel>
      <StackPanel Grid.Row="2" Margin="0,0,0,10">
       <WrapPanel>
        <CheckBox x:Name="OnlySelectedFilter" Content="{DynamicResource Label55}" Checked="FilterChanged" Unchecked="FilterChanged" Margin="0,8,18,8"/>
        <CheckBox x:Name="BelowTargetFilter" Content="{DynamicResource Label56}" Checked="FilterChanged" Unchecked="FilterChanged" Margin="0,8,18,8"/>
        <CheckBox x:Name="PinSelectedFilter" Content="{DynamicResource Label57}" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" Margin="0,8,18,8"/>
        <Button Content="{DynamicResource Label58}" Click="SelectVisibleClick" Margin="0,0,8,4" ToolTip="{DynamicResource Label59}"/>
        <Button Content="{DynamicResource Label60}" Click="ClearSelectedClick" Margin="0,0,8,4"/>
        <Button Content="{DynamicResource Label61}" Click="ResetFiltersClick" Margin="0,0,0,4"/>
       </WrapPanel>
       <TextBlock x:Name="GearHint" Text="{DynamicResource Label62}" TextWrapping="Wrap" Foreground="{StaticResource MutedInk}" Margin="0,4,0,0"/>
      </StackPanel>
      <DataGrid x:Name="GearGrid" Grid.Row="3" RowHeight="84" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="GearFocused" IsReadOnly="True" AutomationProperties.Name="{DynamicResource Label63}" HorizontalScrollBarVisibility="Auto">
       <DataGrid.Columns>
        <DataGridTemplateColumn Header="{DynamicResource Label64}" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Chosen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Eligible}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Identity}" ToolTip="{Binding EligibilityText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{DynamicResource Label65}" Width="210"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center" Margin="8,4" ToolTip="{Binding Detail}"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Category}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding IdLabel}" Style="{StaticResource MetaText}" TextWrapping="Wrap"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{DynamicResource Label66}" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center" Margin="8,4"><TextBlock Text="{Binding Owner}" TextWrapping="Wrap"/><TextBlock Text="{Binding ExclusiveLabel}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding Flags}" Style="{StaticResource MetaText}" TextWrapping="Wrap"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{DynamicResource Label67}" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center" Margin="8,4"><TextBlock Text="{Binding ScoreLabel}" FontWeight="SemiBold"/><TextBlock Text="{Binding Ranks}" Margin="0,4,0,0"/><TextBlock Text="{Binding Enhancement}" Style="{StaticResource MetaText}" TextWrapping="Wrap"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{DynamicResource Label68}" Width="240"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding MainLines}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,4" ToolTip="{Binding Detail}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{DynamicResource Label69}" Width="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SubLines}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,4" ToolTip="{Binding Detail}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
      <Border Grid.Row="4" Background="{StaticResource SurfaceMuted}" Padding="10" Margin="0,10,0,0"><ScrollViewer MaxHeight="75" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="GearDetail" Text="{DynamicResource Label70}" TextWrapping="Wrap" Foreground="{StaticResource MutedInk}"/></ScrollViewer></Border>
     </Grid></ScrollViewer>
    </Border>
   </TabItem>
  </TabControl>
  <StackPanel Grid.Row="3" Margin="0,14,0,0">
   <TextBlock x:Name="SummaryText" Text="{DynamicResource Label71}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,10"/>
   <DockPanel LastChildFill="False"><Button x:Name="ExecuteButton" DockPanel.Dock="Right" Content="{DynamicResource Label72}" Style="{StaticResource PrimaryButton}" Click="ExecuteClick" IsEnabled="False" MinWidth="135"/><Button x:Name="StopButton" DockPanel.Dock="Right" Content="{DynamicResource Label73}" Click="StopClick" IsEnabled="False" Margin="0,0,10,0"/><Button x:Name="CalculateButton" Content="{DynamicResource Label74}" Click="CalculateClick" IsEnabled="False"/><Button Content="{DynamicResource Label75}" Click="RecordsClick" Margin="10,0,0,0"/></DockPanel>
   <TextBlock x:Name="StatusText" Text="{DynamicResource Label76}" TextWrapping="Wrap" MaxHeight="65" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{StaticResource MutedInk}" Margin="0,10,0,0"/>
  </StackPanel>
 </Grid>
</Window>