<Window x:Class="BD2Rhythm.Desktop.RhythmWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource Label1}" Width="680" Height="700" MinWidth="560" MinHeight="460" WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" Closing="OnClosing">
<Grid Margin="24">
 <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
  <DockPanel><ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="126" VerticalAlignment="Top" SelectionChanged="LanguageChanged" AutomationProperties.Name="Language / 语言"><ComboBoxItem Content="简体中文" Tag="zh-CN"/><ComboBoxItem Content="English" Tag="en-US"/></ComboBox><TextBlock Text="{DynamicResource Label1}" FontSize="24" FontWeight="SemiBold"/></DockPanel>
  <TextBlock Text="{DynamicResource Label2}" Margin="0,8,0,24" Foreground="{DynamicResource MutedInk}" TextWrapping="Wrap"/>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="20" CornerRadius="10"><StackPanel>
   <TextBlock x:Name="StateText" Text="{DynamicResource Label6}" FontSize="19" FontWeight="SemiBold"/>
   <TextBlock x:Name="ReasonText" Text="{DynamicResource Label7}" TextWrapping="Wrap" Margin="0,8,0,22" Foreground="{DynamicResource MutedInk}"/>
   <TextBlock x:Name="SongText" Text="{DynamicResource Label8}" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Height="6" Margin="0,14,0,10" Foreground="{DynamicResource Primary}" AutomationProperties.Name="{DynamicResource Label9}"/>
   <TextBlock x:Name="ProgressText" Text="{DynamicResource Label9}" Foreground="{DynamicResource MutedInk}"/>
   <TextBlock x:Name="MetricsText" Text="{DynamicResource Label10}" Foreground="{DynamicResource MutedInk}" Margin="0,8,0,0" TextWrapping="Wrap"/>
  </StackPanel></Border>
  <TextBlock Text="{DynamicResource Label11}" FontWeight="SemiBold" Margin="0,24,0,14"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel><Label Foreground="{DynamicResource Ink}" Target="{Binding ElementName=JitterBox}" Padding="0" Content="{DynamicResource Label12}"/><TextBox x:Name="JitterBox" Text="50" Margin="0,8,0,0" LostFocus="SettingsChanged"/></StackPanel>
   <StackPanel Grid.Column="2"><Label Foreground="{DynamicResource Ink}" Target="{Binding ElementName=OffsetBox}" Padding="0" Content="{DynamicResource Label13}"/><TextBox x:Name="OffsetBox" Text="0" Margin="0,8,0,0" LostFocus="SettingsChanged"/></StackPanel>
  </Grid>
  <TextBlock x:Name="SettingsHint" Text="{DynamicResource Label14}" Foreground="{DynamicResource MutedInk}" Margin="0,12,0,0" TextWrapping="Wrap"/>
  <TextBlock Text="{DynamicResource Label15}" Margin="0,12,0,16" TextWrapping="Wrap" Foreground="{DynamicResource MutedInk}"/>
 </StackPanel></ScrollViewer>
 <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,16,0,0"><Grid>
  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <Button x:Name="ConnectButton" Content="{DynamicResource Label3}" Click="ConnectClick" HorizontalAlignment="Left"/>
  <Button Grid.Column="1" x:Name="StopButton" Content="{DynamicResource Label5}" Click="StopClick" IsEnabled="False" Margin="0,0,10,0"/>
  <Button Grid.Column="2" x:Name="StartButton" Content="{DynamicResource Label4}" Style="{DynamicResource PrimaryButton}" Click="StartClick" IsEnabled="False"/>
 </Grid></Border>
</Grid></Window>
