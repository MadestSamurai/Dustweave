<Window x:Class="BD2Sichuan.Desktop.SichuanWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="连连看" Width="1080" Height="800" MinWidth="720" MinHeight="640"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource Ink}">
 <Grid Margin="24,0,24,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16">
   <ComboBox x:Name="LanguageBox" Visibility="Collapsed" SelectionChanged="LanguageChanged"><ComboBoxItem Content="简体中文" Tag="zh-CN"/><ComboBoxItem Content="English" Tag="en-US"/></ComboBox>
   <TextBlock x:Name="ConnectionText" Text="未连接" Foreground="{DynamicResource MutedInk}" TextWrapping="Wrap"/>
   <TextBlock x:Name="StatusText" Text="连接游戏后自动显示盘面，再选择提示或自动本局。" TextWrapping="Wrap" Margin="0,6,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="12">
    <Grid><Viewbox Stretch="Uniform"><Canvas x:Name="BoardCanvas" Width="600" Height="400"/></Viewbox><TextBlock x:Name="EmptyText" Text="等待连连看盘面&#10;进入小游戏后自动识别，无需先消除一对。" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedInk}" FontSize="16" Margin="16"/></Grid>
   </Border>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"><StackPanel>
    <TextBlock Text="下一对提示" Foreground="{DynamicResource MutedInk}" Margin="0,0,0,6"/>
    <TextBlock x:Name="HintText" Text="连接后显示下一对" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock x:Name="DetailText" Text="下一对会以 ①、② 标在盘面上并显示连线；在游戏中手动消除，提示会跟随盘面更新。" Margin="0,8,0,12" Foreground="{DynamicResource MutedInk}" TextWrapping="Wrap"/>
    <WrapPanel><Button x:Name="ToggleButton" Content="开始提示" Click="Toggle_Click" Margin="0,0,8,8"/><Button x:Name="StepButton" Content="执行下一对" Click="Step_Click" Margin="0,0,0,8"/></WrapPanel>
    <Separator Margin="0,12,0,20"/>
    <TextBlock Text="自动本局" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <TextBlock Text="配对间隔" Margin="0,0,0,8"/>
    <StackPanel Orientation="Horizontal"><TextBox x:Name="IntervalBox" Text="1000" Width="120" KeyDown="Interval_KeyDown" LostFocus="Interval_Click" AutomationProperties.Name="配对间隔，毫秒"/><TextBlock Text="毫秒" Foreground="{DynamicResource MutedInk}" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
    <TextBlock x:Name="IntervalText" Text="改完即生效，运行中也可以调整。1000 毫秒 = 1 秒。" Foreground="{DynamicResource MutedInk}" TextWrapping="Wrap" Margin="0,8,0,16"/>
    <TextBlock x:Name="AutomationText" Text="点击右下角「开始本局」后，按上面的间隔自动消除到本局结束。" TextWrapping="Wrap" Foreground="{DynamicResource MutedInk}"/>
    <TextBlock x:Name="RouteText" TextWrapping="Wrap" Margin="0,12,0,0"/>
    <TextBlock x:Name="MetaText" TextWrapping="Wrap" Foreground="{DynamicResource MutedInk}" Margin="0,8,0,0"/>
    <Separator Margin="0,16,0,16"/>
    <CheckBox Content="窗口置顶" Checked="Topmost_Changed" Unchecked="Topmost_Changed"/>
   </StackPanel></ScrollViewer>
  </Grid>
  <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
   <DockPanel LastChildFill="False"><Button x:Name="ConnectButton" Content="连接游戏" Click="Connect_Click" DockPanel.Dock="Left"/>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="StopButton" Content="立即停止" Click="Stop_Click" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="AutoButton" Content="自动本局" Click="Auto_Click" Style="{DynamicResource PrimaryButton}"/></StackPanel>
   </DockPanel>
  </Border>
 </Grid>
</Window>
