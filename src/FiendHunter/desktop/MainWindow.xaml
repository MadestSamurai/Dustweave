<Window x:Class="BD2FiendHunter.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource title}" Width="620" Height="620" MinWidth="490" MinHeight="570" WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource Ink}">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="{DynamicResource title}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource subtitle}" Foreground="{DynamicResource MutedInk}" Margin="0,6,0,0"/></StackPanel>
   <ComboBox Grid.Column="1" x:Name="LanguageBox" MinWidth="110" VerticalAlignment="Top" SelectionChanged="LanguageChanged" AutomationProperties.Name="Language"><ComboBoxItem Content="简体中文" Tag="zh-CN"/><ComboBoxItem Content="English" Tag="en-US"/></ComboBox>
  </Grid>
  <StackPanel Grid.Row="1" Margin="0,24,0,20"><TextBlock Text="{DynamicResource select-boss}" Margin="0,0,0,8"/><ComboBox x:Name="BossChoice" SelectedIndex="0" SelectionChanged="BossChanged" AutomationProperties.Name="{DynamicResource select-boss}"><ComboBoxItem Content="{DynamicResource boss-1}"/><ComboBoxItem Content="{DynamicResource boss-2}"/></ComboBox></StackPanel>
  <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="20">
   <StackPanel><TextBlock x:Name="PlayerText" Margin="0,0,0,10"/><ProgressBar x:Name="PlayerBar" Height="8" Maximum="1" Foreground="{DynamicResource Primary}" AutomationProperties.Name="{DynamicResource player}"/>
    <TextBlock x:Name="BossText" Margin="0,22,0,10"/><ProgressBar x:Name="BossBar" Height="8" Maximum="1" Foreground="{DynamicResource Primary}" AutomationProperties.Name="{DynamicResource boss}"/>
   </StackPanel>
  </Border>
  <StackPanel Grid.Row="3" Margin="0,18,0,20"><TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedInk}" TextWrapping="Wrap" LineHeight="22"/><TextBlock Text="{DynamicResource hint}" Foreground="{DynamicResource MutedInk}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel>
  <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="ConnectButton" Content="{DynamicResource reconnect}" HorizontalAlignment="Left" Click="Connect"/>
   <Button Grid.Column="1" x:Name="PauseButton" Content="{DynamicResource pause}" Click="Pause" Margin="0,0,10,0"/>
   <Button Grid.Column="2" x:Name="StartButton" Content="{DynamicResource start}" Click="Start" Style="{DynamicResource PrimaryButton}"/>
  </Grid>
 </Grid>
</Window>
