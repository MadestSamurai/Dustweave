<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><PlatformTarget>x64</PlatformTarget><AssemblyName>Dustweave.Launcher</AssemblyName>
    <Version>1.0.0</Version><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <PublishSingleFile>false</PublishSingleFile><RuntimeFrameworkVersion>$(DustweaveRuntimeVersion)</RuntimeFrameworkVersion>
    <DebugType>None</DebugType><DebugSymbols>false</DebugSymbols><IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>../Desktop/app.manifest</ApplicationManifest><ApplicationIcon>../../assets/branding/Dustweave.ico</ApplicationIcon>
    <Product>Dustweave</Product><Description>Dustweave startup and update recovery</Description>
  </PropertyGroup>
  <!-- Match the compiler's framework overrides before WPF loads framework v8 equivalents. -->
  <ItemGroup><PackageReference Include="System.Collections.Immutable" Version="9.0.0" /><PackageReference Include="System.Reflection.Metadata" Version="9.0.0" /></ItemGroup>
</Project>
