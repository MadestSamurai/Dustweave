<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework><RuntimeIdentifier>win-x64</RuntimeIdentifier><PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Dustweave.Updater</AssemblyName><Version>1.0.0</Version>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <SelfContained>true</SelfContained><RuntimeFrameworkVersion>$(DustweaveRuntimeVersion)</RuntimeFrameworkVersion>
    <PublishSingleFile>true</PublishSingleFile><EnableCompressionInSingleFile>true</EnableCompressionInSingleFile><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>None</DebugType><DebugSymbols>false</DebugSymbols><IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>../Desktop/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Core/DailyUpdate*.cs;../Core/DailyVersion.cs;../Core/DailyApplication.cs" Link="Shared/%(Filename)%(Extension)" />
    <ProjectReference Include="../Accounts/Dustweave.Accounts.csproj" />
    <EmbeddedResource Include="../../assets/updates/trust.json" LogicalName="Dustweave.update-trust.json" />
  </ItemGroup>
</Project>
