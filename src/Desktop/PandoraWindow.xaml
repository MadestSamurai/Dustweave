<Window x:Class="Dustweave.Desktop.PandoraWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:Dustweave.Desktop" Title="PANDORA ESCAPE · Dustweave" Width="650" Height="650" MinWidth="580" MinHeight="540" WindowStartupLocation="CenterScreen">
 <Grid Margin="24,8,24,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,22"><TextBlock Text="{l:Tr pandora.title}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{l:Tr pandora.entry}" TextWrapping="Wrap" Foreground="{DynamicResource MutedInk}" Margin="0,6,0,0"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
     <RadioButton x:Name="CurrencyMode" Foreground="{DynamicResource Ink}" Content="{l:Tr pandora.currency}" IsChecked="True" Checked="ModeChanged" Margin="0,0,28,0"/>
     <RadioButton x:Name="ChallengeMode" Foreground="{DynamicResource Ink}" Content="{l:Tr pandora.challenge}" Checked="ModeChanged"/>
    </StackPanel>
    <StackPanel x:Name="StagePanel" Margin="0,0,0,20">
     <TextBlock Text="{l:Tr pandora.stage}" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <ComboBox x:Name="StageBox" DisplayMemberPath="Label" SelectedValuePath="Id" MinHeight="38" SelectionChanged="StageChanged"/>
     <TextBlock x:Name="StageHint" Text="{l:Tr pandora.repeat}" FontSize="12" Foreground="{DynamicResource MutedInk}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
    <StackPanel Margin="0,0,0,20">
     <TextBlock Text="{l:Tr pandora.character}" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <ComboBox x:Name="CharacterBox" DisplayMemberPath="Label" MinHeight="38" SelectionChanged="CharacterChanged" AutomationProperties.Name="{l:Tr pandora.character}">
      <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="IsEnabled" Value="{Binding Available}"/></Style></ComboBox.ItemContainerStyle>
     </ComboBox>
     <TextBlock x:Name="CharacterHint" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedInk}" Margin="0,8,0,0"/>
    </StackPanel>
    <TextBlock x:Name="ChallengeNotice" Visibility="Collapsed" Text="{l:Tr pandora.challenge_warning}" Foreground="{DynamicResource MutedInk}" TextWrapping="Wrap" Margin="0,0,0,20"/>
    <StackPanel x:Name="EquipmentPanel" Visibility="Collapsed" Margin="0,0,0,20">
     <CheckBox x:Name="AutoEquipment" IsChecked="True" Content="{l:Tr pandora.auto_equipment}"/>
     <TextBlock Text="{l:Tr pandora.auto_equipment_hint}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedInk}" Margin="0,6,0,0"/>
    </StackPanel>
    <Border Background="{DynamicResource SurfaceMuted}" CornerRadius="12" Padding="18">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="{l:Tr pandora.rounds}" Foreground="{DynamicResource MutedInk}"/><TextBlock x:Name="RoundsText" Text="0" FontSize="26" Margin="0,6,0,0"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="{l:Tr pandora.time}" Foreground="{DynamicResource MutedInk}"/><TextBlock x:Name="TimeText" Text="—" FontSize="26" Margin="0,6,0,0"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="{l:Tr pandora.health}" Foreground="{DynamicResource MutedInk}"/><TextBlock x:Name="HealthText" Text="—" FontSize="26" Margin="0,6,0,0"/></StackPanel>
     </Grid>
    </Border>
    <TextBlock x:Name="StatusText" Text="{l:Tr pandora.state.ready}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,18,0,0"/>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="2" Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{l:Tr pandora.stop_hint}" Foreground="{DynamicResource MutedInk}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button x:Name="ConnectButton" Content="{l:Tr mansion.connect}" Click="ConnectClicked" Margin="0,0,8,0"/>
    <Button x:Name="StopButton" Content="{l:Tr mansion.stop}" Click="StopClicked" IsEnabled="False" Margin="0,0,8,0"/>
    <Button x:Name="StartButton" Content="{l:Tr mansion.start}" Click="StartClicked" IsEnabled="False" Style="{StaticResource PrimaryButton}"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
