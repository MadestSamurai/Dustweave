<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="TimelineContainer" TargetType="ListBoxItem">
  <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
  <Setter Property="AutomationProperties.HelpText" Value="{Binding Detail}"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
   <Grid>
    <Border x:Name="Frame" Background="Transparent" CornerRadius="8"/>
    <!-- The rail spans the whole item, including the content's focus-border inset. -->
    <Grid IsHitTestVisible="False"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="TimelineRail" Width="1" HorizontalAlignment="Center" Background="{DynamicResource Line}" SnapsToDevicePixels="True"/>
    </Grid>
    <ContentPresenter Margin="3,1"/>
    <Border x:Name="FocusRing" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" IsHitTestVisible="False"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource SurfaceMuted}"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Focus}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <DataTemplate x:Key="DailyTimelineItem">
  <Grid ToolTip="{Binding DiagnosticDetail}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="MarkerCircle" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Top" Margin="0,12,0,0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
    <Path Style="{StaticResource LineIcon}" Data="{Binding Icon}" Stroke="{Binding StateBrush}"/>
   </Border>
   <Border x:Name="Body" Grid.Column="1" Padding="12,10" CornerRadius="8" Margin="0,2,8,2">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,14,0">
      <CheckBox x:Name="Choice" IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.HelpText="{Binding Detail}" FontWeight="SemiBold" FontSize="14"><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></CheckBox>
      <TextBlock x:Name="Label" Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed"/>
      <TextBlock x:Name="Explanation" Text="{Binding Detail}" Foreground="{DynamicResource MutedInk}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"/>
     </StackPanel>
     <TextBlock x:Name="StateLabel" Grid.Column="1" Text="{Binding State}" Foreground="{Binding StateBrush}" FontSize="12" VerticalAlignment="Top" Margin="0,4,0,0" MaxWidth="150" TextWrapping="Wrap"/>
    </Grid>
   </Border>
  </Grid>
  <DataTemplate.Triggers><DataTrigger Binding="{Binding Compact}" Value="True"><Setter TargetName="Explanation" Property="Visibility" Value="Collapsed"/></DataTrigger>
   <DataTrigger Binding="{Binding IsPlan}" Value="True">
    <Setter TargetName="Explanation" Property="Visibility" Value="Collapsed"/>
    <Setter TargetName="StateLabel" Property="Visibility" Value="Collapsed"/>
   </DataTrigger>
   <DataTrigger Binding="{Binding CanEdit}" Value="False"><Setter TargetName="Choice" Property="Visibility" Value="Collapsed"/><Setter TargetName="Label" Property="Visibility" Value="Visible"/></DataTrigger>
   <DataTrigger Binding="{Binding Active}" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource PrimarySoft}"/><Setter TargetName="MarkerCircle" Property="Background" Value="{DynamicResource PrimarySoft}"/><Setter TargetName="MarkerCircle" Property="BorderBrush" Value="{DynamicResource Primary}"/></DataTrigger>
   <DataTrigger Binding="{Binding NeedsAttention}" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource ErrorSoft}"/><Setter TargetName="MarkerCircle" Property="Background" Value="{DynamicResource ErrorSoft}"/><Setter TargetName="MarkerCircle" Property="BorderBrush" Value="{DynamicResource Error}"/></DataTrigger>
  </DataTemplate.Triggers>
 </DataTemplate>
</ResourceDictionary>
