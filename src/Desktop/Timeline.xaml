<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BD2Daily.Desktop">
 <local:ProgressRingConverter x:Key="ProgressRingConverter"/>
 <Style x:Key="CircularProgress" TargetType="ProgressBar">
  <Setter Property="Width" Value="68"/><Setter Property="Height" Value="68"/>
  <Setter Property="Foreground" Value="{DynamicResource Primary}"/><Setter Property="Background" Value="{DynamicResource Line}"/>
  <Setter Property="Focusable" Value="False"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
   <Grid>
    <Viewbox Stretch="Uniform" IsHitTestVisible="False">
     <Grid Width="72" Height="72">
      <Ellipse Width="62" Height="62" Stroke="{TemplateBinding Background}" StrokeThickness="5"/>
      <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
       <Path.Data><MultiBinding Converter="{StaticResource ProgressRingConverter}">
        <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/><Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}"/><Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}"/>
       </MultiBinding></Path.Data>
      </Path>
     </Grid>
    </Viewbox>
    <TextBlock x:Name="Percentage" Foreground="{DynamicResource Ink}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" IsHitTestVisible="False">
     <TextBlock.Text><MultiBinding Converter="{StaticResource ProgressRingConverter}" ConverterParameter="text">
      <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/><Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}"/><Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}"/>
     </MultiBinding></TextBlock.Text>
    </TextBlock>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="TimelineContainer" TargetType="ListBoxItem">
  <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
  <Setter Property="AutomationProperties.HelpText" Value="{Binding Detail}"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
   <Grid>
    <Border x:Name="Frame" Background="Transparent" CornerRadius="8"/>
    <!-- The rail spans the whole item, including the content's focus-border inset. -->
    <Grid IsHitTestVisible="False"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="TimelineRail" Width="1" HorizontalAlignment="Center" Background="{DynamicResource Line}" SnapsToDevicePixels="True"/>
    </Grid>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Margin="54,0,12,0" IsHitTestVisible="False"/>
    <ContentPresenter Margin="3,1"/>
    <Border x:Name="FocusRing" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" IsHitTestVisible="False"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource SurfaceMuted}"/></Trigger>
    <DataTrigger Binding="{Binding Active}" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource PrimarySoft}"/></DataTrigger>
    <DataTrigger Binding="{Binding NeedsAttention}" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ErrorSoft}"/></DataTrigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Focus}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <DataTemplate x:Key="DailyTimelineItem">
  <Grid ToolTip="{Binding DiagnosticDetail}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="MarkerCircle" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Top" Margin="0,12,0,0" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
    <Path x:Name="MarkerIcon" Style="{StaticResource LineIcon}" Data="{Binding Icon}" Stroke="{Binding StateBrush}"/>
   </Border>
   <Border x:Name="Body" Grid.Column="1" Padding="12,10" CornerRadius="8" Margin="0,2,8,2">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto" SharedSizeGroup="StageStatus"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,14,0">
      <CheckBox x:Name="Choice" IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.HelpText="{Binding Detail}" FontWeight="Normal" FontSize="14"><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></CheckBox>
      <TextBlock x:Name="Label" Text="{Binding Name}" FontWeight="Normal" TextWrapping="Wrap" Visibility="Collapsed"/>
      <TextBlock x:Name="Explanation" Text="{Binding Detail}" Foreground="{DynamicResource MutedInk}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"/>
     </StackPanel>
     <TextBlock x:Name="FinishedTime" Grid.Column="1" Text="{Binding FinishedTime}" ToolTip="{Binding FinishedTimeHelp}" AutomationProperties.Name="{Binding FinishedTimeHelp}" Foreground="{DynamicResource MutedInk}" FontSize="12" Typography.NumeralAlignment="Tabular" Margin="8,4,16,0" VerticalAlignment="Top" Visibility="Collapsed"/>
     <TextBlock x:Name="StateLabel" Grid.Column="2" VerticalAlignment="Top" Padding="8,4" MaxWidth="150" Text="{Binding State}" Foreground="{Binding StateBrush}" FontSize="12" TextWrapping="Wrap"/>
    </Grid>
   </Border>
  </Grid>
  <DataTemplate.Triggers><DataTrigger Binding="{Binding Compact}" Value="True"><Setter TargetName="Explanation" Property="Visibility" Value="Collapsed"/></DataTrigger>
   <DataTrigger Binding="{Binding HasFinishedTime}" Value="True"><Setter TargetName="FinishedTime" Property="Visibility" Value="Visible"/></DataTrigger>
   <DataTrigger Binding="{Binding IsPlan}" Value="True">
    <Setter TargetName="FinishedTime" Property="Visibility" Value="Collapsed"/>
    <Setter TargetName="Explanation" Property="Visibility" Value="Collapsed"/>
    <Setter TargetName="StateLabel" Property="Visibility" Value="Collapsed"/>
   </DataTrigger>
   <DataTrigger Binding="{Binding CanEdit}" Value="False"><Setter TargetName="Choice" Property="Visibility" Value="Collapsed"/><Setter TargetName="Label" Property="Visibility" Value="Visible"/></DataTrigger>
   <DataTrigger Binding="{Binding Completed}" Value="True">
    <Setter TargetName="MarkerCircle" Property="Background" Value="{DynamicResource Primary}"/><Setter TargetName="MarkerCircle" Property="BorderBrush" Value="{DynamicResource Primary}"/>
    <Setter TargetName="MarkerIcon" Property="Stroke" Value="{DynamicResource PrimaryInk}"/>
   </DataTrigger>
   <DataTrigger Binding="{Binding Active}" Value="True">
    <Setter TargetName="MarkerCircle" Property="Background" Value="{DynamicResource Primary}"/><Setter TargetName="MarkerCircle" Property="BorderBrush" Value="{DynamicResource Primary}"/>
    <Setter TargetName="MarkerIcon" Property="Stroke" Value="{DynamicResource PrimaryInk}"/>
    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
   </DataTrigger>
   <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
    <Setter TargetName="MarkerCircle" Property="Background" Value="{DynamicResource ErrorSoft}"/><Setter TargetName="MarkerCircle" Property="BorderBrush" Value="{DynamicResource Error}"/>
   </DataTrigger>
  </DataTemplate.Triggers>
 </DataTemplate>
</ResourceDictionary>
