<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><StartupObject>Dustweave.Desktop.Program</StartupObject><TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained><PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract><EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Tool EXE assemblies are loaded as WPF applications inside this shared host, not launched by their apphosts. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <PublishTrimmed>false</PublishTrimmed><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>Dustweave</AssemblyName><RootNamespace>Dustweave.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>../../assets/branding/Dustweave.ico</ApplicationIcon><Product>Dustweave</Product>
    <Version Condition="'$(DustweaveVersion)' != ''">$(DustweaveVersion)</Version><Company>MadSamurai</Company><Description>多账号登录与日常任务工作台</Description>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Core/Dustweave.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Connection/Dustweave.Connection.csproj" Aliases="liveUtility" />
    <ProjectReference Include="../ToolHost/Dustweave.ToolHost.csproj" Aliases="minigameUtility" />
    <ProjectReference Include="../../tools/RuntimeCheck/Dustweave.RuntimeCheck.csproj" Aliases="diagnosticUtility" />
    <ProjectReference Include="../../tools/TableExporter/Dustweave.TableExporter.csproj" Aliases="exportUtility" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../standalone/bd2-fishing/desktop/BD2Fishing.Desktop.csproj" Aliases="toolBD2Fishing" />
    <ProjectReference Include="../../standalone/bd2-sichuan/desktop/BD2Sichuan.Desktop.csproj" Aliases="toolBD2Sichuan" />
    <ProjectReference Include="../../standalone/bd2-rhythm/desktop/BD2Rhythm.Desktop.csproj" Aliases="toolBD2Rhythm" />
    <ProjectReference Include="../../standalone/bd2-territory/desktop/BD2Territory.Desktop.csproj" Aliases="toolBD2Territory" />
    <ProjectReference Include="../../standalone/bd2-equipment-assistant/desktop/BD2EquipmentAssistant.csproj" Aliases="toolBD2EquipmentAssistant" />
    <ProjectReference Include="../../standalone/bd2-apostle-defense/desktop/BD2ApostleDefense.Desktop.csproj" Aliases="toolBD2ApostleDefense" />
    <ProjectReference Include="../../standalone/bd2-infinite-gacha/desktop/BD2InfiniteGacha.Desktop.csproj" Aliases="toolBD2InfiniteGacha" />
    <ProjectReference Include="../../standalone/bd2-secret-vision/desktop/BD2SecretVision.Desktop.csproj" Aliases="toolBD2SecretVision" />
    <ProjectReference Include="../../standalone/bd2-fiend-hunter/desktop/BD2FiendHunter.Desktop.csproj" Aliases="toolBD2FiendHunter" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="Localization/plugin-strings.json" LogicalName="Dustweave.UI.plugin-strings.json" /><EmbeddedResource Include="Localization/strings.json" LogicalName="Dustweave.UI.strings.json" /><EmbeddedResource Include="Localization/runtime.json" LogicalName="Dustweave.UI.runtime.json" /><EmbeddedResource Include="Localization/notices.json" LogicalName="Dustweave.UI.notices.json" /><EmbeddedResource Include="Localization/releases.json" LogicalName="Dustweave.UI.releases.json" /></ItemGroup>
  <ItemGroup><Using Include="BD2Daily" /></ItemGroup>
  <ItemGroup><Resource Include="../../assets/branding/Dustweave.ico" Link="Assets/Dustweave.ico" /></ItemGroup>
</Project>
