<Project>
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PathMap>$(MSBuildThisFileDirectory)=/_/Dustweave/</PathMap>
    <DustweaveRuntimeVersion>8.0.30</DustweaveRuntimeVersion>
  </PropertyGroup>
  <!-- Keep connection identities independent from the product label. Standalone tools use their own props. -->
  <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('Dustweave.'))">
    <Version>0.7.27</Version>
    <DustweaveVersion Condition="'$(DustweaveVersion)' == ''">1.4.16</DustweaveVersion>
  </PropertyGroup>
</Project>
