<Project>
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <!-- Keep connection identities independent from the product label. Standalone tools use their own props. -->
  <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('BD2Daily.')) Or '$(MSBuildProjectName)' == 'Dustweave.Tests'">
    <Version>0.7.27</Version>
    <DustweaveVersion Condition="'$(DustweaveVersion)' == ''">0.8.13</DustweaveVersion>
  </PropertyGroup>
</Project>