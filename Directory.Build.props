<Project>
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <!-- Keep connection identities independent from the product label. Standalone tools use their own props. -->
  <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('Dustweave.'))">
    <Version>0.7.27</Version>
    <DustweaveVersion Condition="'$(DustweaveVersion)' == ''">1.1.1-beta</DustweaveVersion>
  </PropertyGroup>
</Project>
